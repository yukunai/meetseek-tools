DATABASE_URL=sqlite:///./meetseek.db
JWT_SECRET_KEY=
PASSWORD_HASH_SALT=
CORS_ALLOWED_ORIGINS=https://meetseek.ai,https://www.meetseek.ai,https://tools.meetseek.ai,https://prompts.meetseek.ai
SITE_URL=https://meetseek.ai
AUTH_COOKIE_DOMAIN=.meetseek.ai
MAX_JSON_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=8388608
LOGIN_FAILURE_DELAY_SECONDS=1.5
ADMIN_FAILURE_DELAY_SECONDS=1.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
MOCK_LOGIN_PASSWORD=

# meetseek-tools (app/main.py, Docker) — generate secrets: openssl rand -hex 32
JWT_SECRET=
SECRET_KEY=
ADMIN_TOKEN=
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=
SQLADMIN_SECRET_KEY=
# MEETSEEK_DEV_INSECURE_JWT=1
# Optional full CSP override for app/static pages (sqladmin /admin is excluded):
# SECURITY_CSP=default-src 'self'
# Comma-separated admin emails for prompt gallery moderation (no default):
# PROMPT_ADMIN_EMAILS=you@example.com
